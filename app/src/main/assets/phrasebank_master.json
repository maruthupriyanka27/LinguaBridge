    "santali_translit": "Apnarag machi/pati re thik te durup pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P037",
    "hindi": "क्लासरूम के अंदर मत भागो।",
