    "santali_translit": "Classroom bhitir re alo pe dara.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P038",
    "hindi": "सीधी लाइन में खड़े हो जाओ।",
    "santali": "ᱥᱚजᱷᱮ ᱞᱟᱭᱤᱱ ᱨᱮ ᱛᱤᱸᱜᱩᱱ ᱯᱮ",
    "santali_translit": "Sojhe line re tingun pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
