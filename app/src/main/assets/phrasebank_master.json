[
  {
    "id": "P001",
    "hindi": "सुप्रभात बच्चों!",
    "santali": "ᱥᱟᱹᱜᱩᱱ ᱥᱮᱛᱟᱜ, ᱜᱤᱫᱽᱨᱟᱹ ᱠᱚ!",
    "santali_translit": "Sagun setah, gidra ko!",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P002",
    "hindi": "कृपया बैठ जाइए।",
    "santali": "ᱫᱩᱲᱩᱵ ᱯᱮ, ᱫᱟᱭᱟ ᱠᱟᱛᱮ",
    "santali_translit": "Durup pe, daya kate.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P003",
    "hindi": "अपने बैग करीने से रखो।",
    "santali": "ᱵᱮᱜᱽ ᱱᱟᱯᱟᱭ ᱛᱮ ᱫᱚᱦᱚᱭ ᱯᱮ",
    "santali_translit": "Bag napay te dohoy pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P004",
    "hindi": "अपनी पानी की बोतलें निकालो और साइड में रखो।",
    "santali": "ᱟᱯᱱᱟᱨᱟᱜ ᱫᱟᱜ ᱵᱚᱛᱚᱞ ᱚᱰᱚᱠ ᱯᱮ ᱟᱨ ᱫᱷᱟᱨᱮ ᱨे ᱫᱚᱦᱚᱭ ᱯᱮ",
    "santali_translit": "Apnarag dag botol odok pe aar dhare re dohoy pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P005",
    "hindi": "चलो, अब हाज़िरी लेते हैं।",
    "santali": "ᱫᱮᱞᱟ, ᱱᱤᱛᱚᱜ ᱦᱟᱡᱤᱨᱤ ᱵᱚᱱ ᱦᱟᱛᱟᱣᱟ",
    "santali_translit": "Dela, nitog hajiri bon hatawa.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P006",
    "hindi": "जब तुम्हारा नाम सुनो तो 'प्रेज़ेंट मैम' कहो।",
    "santali": "ᱡᱚᱠᱷᱚᱱ ᱟᱯᱱᱟᱨᱟᱜ ᱧᱩᱛᱩᱢ ᱯᱮ ᱟᱸᱡᱚᱢᱟ, ᱩᱱ ᱡᱚᱠᱷᱚᱱ 'Present Ma'am' ᱢᱮᱱ ᱯᱮ",
    "santali_translit": "Jokhon apnarag nyutum pe anjoma, un jokhon 'Present Ma'am' men pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P007",
    "hindi": "आज कौन अनुपस्थित है?",
    "santali": "ᱛᱮᱦᱮᱧ ᱫᱚ ᱚᱠᱚᱭ ᱵᱟᱹᱱᱩᱜ ᱮᱭᱟ?",
    "santali_translit": "Tehenj do okoy banug eya?",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P008",
    "hindi": "क्या सबने नाश्ता किया?",
    "santali": "ᱪᱮᱫ ᱡᱚᱛᱚ ᱦᱚᱲ ᱥᱮᱛᱟᱜ ᱡᱚᱢᱟᱜ ᱯᱮ ᱡᱚᱢ ᱠᱮᱫᱼᱟ?",
    "santali_translit": "Ched joto hor setag jomag pe jom ked-a?",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P009",
    "hindi": "अपनी डायरी खोलो।",
    "santali": "ᱟᱯᱱᱟᱨᱟᱜ ᱰᱟᱭᱨᱤ ᱡᱷᱤᱡ ᱯᱮ",
    "santali_translit": "Apnarag diary jhij pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P010",
    "hindi": "यहाँ देखो!",
    "santali": "ᱱᱚᱸᱰᱮ ᱠᱚᱭᱚᱜ ᱯᱮ!",
    "santali_translit": "Nonde koyog pe!",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P011",
    "hindi": "बोर्ड की तरफ देखो।",
    "santali": "ᱵᱚᱨᱰ ᱥᱮᱫ ᱠᱚᱭᱚᱜ ᱯᱮ",
    "santali_translit": "Board sed koyog pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P012",
    "hindi": "आँखें मुझ पर, हाथ गोद में रखो।",
    "santali": "ᱢᱮᱫ ᱤᱧ ᱥᱮᱫ, ᱛᱤ ᱫᱚ ᱦᱚᱵᱚᱨ ᱨᱮ ᱫᱚᱦᱚᱭ ᱯᱮ",
    "santali_translit": "Med in sed, ti do hobor re dohoy pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P013",
    "hindi": "हाथ जोड़कर सीधे बैठो।",
    "santali": "ᱛᱤ ᱡᱚᱲᱟᱣ ᱠᱟᱛᱮ ᱥᱚᱡᱷᱮ ᱫᱩᱲᱩᱵ ᱯᱮ",
    "santali_translit": "Ti joraw kate sojhe durup pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P014",
    "hindi": "उंगली होंठों पर रखो—श्श्श!",
    "santali": "ᱞᱩᱴᱤ ᱨᱮ ᱠᱟᱹᱴᱩᱵ ᱫᱚᱦᱚᱭ ᱯᱮ — ᱥᱥᱥ!",
    "santali_translit": "Luti re katub dohoy pe — Sss!",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P015",
    "hindi": "शोर मत करो।",
    "santali": "ᱞᱩᱴᱤ ᱨᱮ ᱠᱟᱹᱴᱩᱵ ᱫᱚᱦᱚᱭ ᱯᱮ — ᱥᱥᱥ!",
    "santali_translit": "Alo pe hullaya.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P016",
    "hindi": "ध्यान से सुनो।",
    "santali": "ᱫᱷᱮᱭᱟᱱ ᱛᱮ ᱟᱸᱡᱚᱢ ᱯᱮ",
    "santali_translit": "Dhyan te anjom pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P017",
    "hindi": "सब लोग शांत हो जाओ!",
    "santali": "ᱡᱚᱛᱚ ᱦᱚᱲ ᱛᱷᱤᱨ ᱠᱚᱜ ᱯᱮ!",
    "santali_translit": "Joto hor thir kog pe!",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P018",
    "hindi": "अब बात करना बंद करो।",
    "santali": "ᱱᱤᱛᱚᱜ ᱜᱟᱞᱢᱟᱨᱟᱣ ᱵᱚᱱᱫᱚᱭ ᱯᱮ",
    "santali_translit": "Nitog galmaraw bondoy pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P019",
    "hindi": "अपनी किताब पन्ना नंबर [X] पर खोलो।",
    "santali": "ᱯᱩᱛᱷᱤ ᱥᱟᱠᱟᱢ ᱮᱞ/ᱯᱮᱡᱽ ᱱᱚᱢᱵᱚᱨ [X] ᱨᱮ ᱡᱷᱤᱡ ᱯᱮ",
    "santali_translit": "Apnarag puthi sakam el/page number [X] re jhij pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P020",
    "hindi": "अपनी पेंसिल और रबड़ निकालो।",
    "santali": "ᱯᱮᱱᱥᱤᱞ ᱟᱨ ᱨᱟᱵᱟᱰ ᱚᱰᱚᱠ ᱯᱮ",
    "santali_translit": "Apnarag pencil aar rubber odok pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P021",
    "hindi": "जैसे मैं पढ़ूँ, अपनी उंगली शब्द के नीचे रखो।",
    "santali": "ᱡᱮᱞᱮᱠᱟᱧ ᱯᱟᱲᱦᱟᱣᱮᱫ-ᱟ, ᱟᱯᱱᱟᱨᱟᱜ ᱠᱟᱹᱴᱩᱵ ᱥᱟᱵᱟᱫ ᱞᱟᱛᱟᱨ ᱨᱮ ᱫᱚᱦᱚᱭ ᱯᱮ",
    "santali_translit": "Jelekany padhawed-a, apnarag katub sabad latar re dohoy pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P022",
    "hindi": "मेरे पीछे दोहराओ।",
    "santali": "ᱤᱧ ᱛᱟᱭᱚᱢ ᱛᱟᱭᱚᱢ ᱛᱮ ᱢᱮᱱ ᱯᱮ",
    "santali_translit": "In tayom tayom te men pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P023",
    "hindi": "इसे ज़ोर से पढ़ो।",
    "santali": "ᱱᱚᱣᱟ ᱡᱚᱨ ᱛे ᱯᱟᱲᱦᱟᱣ ᱯᱮ",
    "santali_translit": "Nowa jor te padhaw pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P024",
    "hindi": "यह अक्षर कैसी आवाज़ करता है?",
    "santali": "ᱱᱚᱣᱟ ᱚᱞ/ᱟᱠᱷᱚᱨ ᱫᱚ ᱪᱮᱫ ᱞᱮᱠᱟ ᱥᱟᱰᱮᱭᱟ?",
    "santali_translit": "Nowa ol/akhor do ched leka sadeya?",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P025",
    "hindi": "साफ-सुथरा लिखो। बिगाड़ो मत।",
    "santali": "ᱥᱟᱯᱷᱟ-ᱥᱟᱯᱷᱟ ᱚᱞ ᱢᱮ, ᱟᱞᱚᱢ ᱵᱟᱹᱲᱤᱡᱟ",
    "santali_translit": "Sapha-sapha ol me, alom barija.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P026",
    "hindi": "इस तस्वीर को देखो। तुम्हें क्या दिख रहा है?",
    "santali": "ᱱᱚᱣᱟ ᱪᱤᱛᱟᱹᱨ ᱠᱚᱭᱚᱜ ᱢᱮ, ᱪᱮᱫ ᱧᱮᱞᱚᱜ ᱠᱟᱱᱟ?",
    "santali_translit": "Nowa chitar koyog me, ched nyelog kana?",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P027",
    "hindi": "इसके बारे में मुझे एक कहानी सुनाओ।",
    "santali": "ᱱᱚᱣᱟ ᱵᱟᱵᱚᱛ ᱛᱮ ᱤᱧ ᱢᱤᱫᱴᱟᱹᱝ ᱠᱟᱹᱦᱱᱤ ᱞᱟᱹᱭ ᱟᱹᱧ ᱢᱮ",
    "santali_translit": "Nowa babot te in midtang kahni lay any me.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P028",
    "hindi": "अक्षरों को धीरे-धीरे ट्रेस करो।",
    "santali": "ᱚᱞ ᱠᱚ ᱵᱟᱹᱭ-ᱵᱟᱹᱭ ᱛᱮ ᱪᱮᱛᱟᱱ ᱨᱮ ᱚᱞ ᱢᱮ",
    "santali_translit": "Ol ko bay-bay te chetan re ol me.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P029",
    "hindi": "चलो साथ में गिनती करते हैं।",
    "santali": "ᱫᱮᱞᱟ ᱥᱟᱶᱛᱮ ᱵᱚᱱ ᱞᱮᱠᱷᱟᱭᱟ",
    "santali_translit": "Dela sawte bon lekhaya.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P030",
    "hindi": "मुझे उंगलियाँ दिखाओ।",
    "santali": "ᱤᱧ ᱠᱟᱹᱴᱩᱵ ᱩᱫᱩᱜ ᱟᱹᱧ ᱯᱮ",
    "santali_translit": "In katub udug any pe.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P031",
    "hindi": "इसके बाद कौन सी संख्या आती है?",
    "santali": "ᱱᱚᱣᱟ ᱛᱟᱭᱚᱢ ᱫᱚ ᱚᱠᱟ ᱞᱮᱠᱷᱟ/ᱮᱞ ᱦᱤᱡᱩᱜ-ᱟ?",
    "santali_translit": "Nowa tayom do oka lekha/el hijug-a?",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P032",
    "hindi": "किस डिब्बे में ज़्यादा चॉकलेट हैं?",
    "santali": "ᱚᱠᱟ ᱰᱤᱵᱽᱞᱟᱹ ᱨᱮ ᱵᱟᱹᱲᱛᱤ ᱪᱚᱠᱞᱮᱴ ᱢᱮᱱᱟᱜ-ᱟ?",
    "santali_translit": "Oka dibla re barti chocolate menag-a?",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P033",
    "hindi": "अपनी कॉपी में तीन गेंदें बनाओ।",
    "santali": "ᱢᱤᱫᱴᱟᱹᱝ ᱠᱷᱟᱛᱟ ᱨᱮ ᱯᱮᱭᱟ ᱵᱚᱞ ᱵᱮᱱᱟᱣ ᱢᱮ",
    "santali_translit": "Apnarag khata re peya ball benaw me.",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P034",
    "hindi": "यह घड़ी किस आकार की है?",
    "santali": "ᱱᱚᱣᱟ ᱜᱷᱩᱲᱤ ᱫᱚ ᱪᱮᱫ ᱞᱮᱠᱟन ᱨᱩᱯ ᱨᱮᱱᱟᱜ ᱠᱟᱱᱟ?",
    "santali_translit": "Nowa ghuri do ched lekan rup renag kana?",
    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P035",
    "hindi": "अपनी मेज़ पर रखे ब्लॉक्स गिनो।",
