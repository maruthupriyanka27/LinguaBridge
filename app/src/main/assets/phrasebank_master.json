    "category": "check-in",
    "fln_component": "Oral Language Development",
    "source": "bhashini_web_manual",
    "verified": false
  },
  {
    "id": "P044",
    "hindi": "फर्श से कागज़ उठाओ और कूड़ेदान में फेंको।",
